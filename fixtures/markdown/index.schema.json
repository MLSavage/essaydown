{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essaydown.dev/fixtures/markdown/index.schema.json",
  "title": "fixtures/markdown/index.json",
  "description": "Per-fixture metadata for the round-trip corpus (PRD §6.1, task 0.4): node types present, blockCount (direct children of root, plus each listItem, plus each tableRow), sectionCount (number of top-level headings), and the 1-based start line of every paragraph node in the fixture's .canonical.md sibling.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9-]+\\.md$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "nodeTypes": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      },
      "blockCount": { "type": "integer", "minimum": 0 },
      "sectionCount": { "type": "integer", "minimum": 0 },
      "paragraphStartLines": {
        "type": "array",
        "items": { "type": "integer", "minimum": 1 }
      }
    },
    "required": ["nodeTypes", "blockCount", "sectionCount", "paragraphStartLines"],
    "additionalProperties": false
  },
  "minProperties": 1
}
