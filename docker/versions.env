# versions.env — every pinned tool in the essaydown-dev image (task 0.0, 2026-09-05).
# Read by docker/Dockerfile (sourced in each RUN) and by CI (task 0.2) so the two agree.
# Bump = a new task with a DECISIONS note; never edit in place on a passed task.
DEBIAN_CODENAME=bookworm
NODE_VERSION=22.22.1
PNPM_VERSION=11.25.0
RUST_TOOLCHAIN=1.98.1
TAURI_DRIVER_VERSION=2.0.6
PANDOC_VERSION=3.11
TYPST_VERSION=0.15.1
EPUBCHECK_VERSION=5.3.0
HTML_VALIDATE_VERSION=11.13.0
CLAUDE_CODE_VERSION=2.1.261
CODEX_VERSION=0.153.4
GROK_VERSION=1.0.13
# poppler-utils (pdfimages, pdftotext) and default-jdk-headless come from Debian bookworm apt;
# their exact versions are printed by `boundary-check` and recorded in the 0.0 journal entry.
